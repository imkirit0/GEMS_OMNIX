// GEMS OMNIX. Foundation schema: organisation, access, sessions, audit, numbering.
// Everything lives in schema "app" (Supabase's public schema is exposed to its Data API, C-15).
// Row-level security, roles and grants are hand-written SQL in the migrations (see 0002_security).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// ---------- Organisation (FR-033.04/.05, FR-022/023; hierarchy semantics open: D-ORG-5) ----------

model Region {
  id     Int              @id @default(autoincrement())
  code   String           @unique
  name   String
  areas  Area[]
  scopes RoleAssignment[]

  @@map("region")
  @@schema("app")
}

model Area {
  id       Int              @id @default(autoincrement())
  regionId Int              @map("region_id")
  name     String
  region   Region           @relation(fields: [regionId], references: [id])
  centres  Centre[]
  scopes   RoleAssignment[]

  @@unique([regionId, name])
  @@map("area")
  @@schema("app")
}

enum CentreStatus {
  INACTIVE
  ACTIVE

  @@schema("app")
}

model Centre {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  areaId          Int              @map("area_id")
  centreClassId   Int?             @map("centre_class_id") // FR-033.06; set by setCentreClass (catalogue-masters DD-2)
  // D-ORG-1 default (UNAPPROVED): centres are created inactive and activated through a checklist
  status          CentreStatus     @default(INACTIVE)
  area            Area             @relation(fields: [areaId], references: [id])
  centreClass     CentreClass?     @relation(fields: [centreClassId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scopes          RoleAssignment[]
  numberSeries    NumberSeries[]
  tickets         Ticket[]
  ticketLevels    TicketLevel[]
  ticketEvents    TicketEvent[]
  ticketUploads   TicketUpload[]
  ticketDocuments TicketDocument[]
  admissions      Admission[]
  registrations   Registration[]

  @@map("centre")
  @@schema("app")
}

// ---------- Access: named users, roles, permission keys, scoped assignments (06 §3) ----------

enum UserStatus {
  ACTIVE
  DISABLED

  @@schema("app")
}

model AppUser {
  id                      String             @id @default(uuid()) @db.Uuid
  login                   String             @unique
  displayName             String             @map("display_name")
  status                  UserStatus         @default(ACTIVE)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz
  // Authentication (ADR-001, candidate B). Hash is argon2id; TOTP secret is AES-256-GCM (AUTH_ENC_KEY).
  passwordHash            String?            @map("password_hash")
  requiresTotp            Boolean            @default(false) @map("requires_totp")
  totpSecretEnc           String?            @map("totp_secret_enc")
  totpLastStep            BigInt?            @map("totp_last_step") // last accepted 30 s step: replay protection
  // second-factor brute-force guard (TOTP + recovery codes), across challenges
  secondFactorFailures    Int                @default(0) @map("second_factor_failures")
  secondFactorLockedUntil DateTime?          @map("second_factor_locked_until") @db.Timestamptz
  assignments             RoleAssignment[]
  sessions                AppSession[]
  challenges              AuthChallenge[]
  recoveryCodes           AuthRecoveryCode[]
  resets                  AuthReset[]
  ticketTypeLevels        TicketTypeLevel[]
  ticketTypeViewers       TicketTypeViewer[]
  ticketsRaised           Ticket[]           @relation("ticketRaisedBy")
  ticketsAssigned         Ticket[]           @relation("ticketAssignedUser")
  ticketLevels            TicketLevel[]
  ticketEventsActed       TicketEvent[]      @relation("ticketEventActor")
  ticketEventsTo          TicketEvent[]      @relation("ticketEventToUser")
  ticketUploads           TicketUpload[]

  @@map("app_user")
  @@schema("app")
}

model Role {
  id                Int                @id @default(autoincrement())
  key               String             @unique
  name              String
  permissions       RolePermission[]
  assignments       RoleAssignment[]
  ticketTypeLevels  TicketTypeLevel[]
  ticketTypeViewers TicketTypeViewer[]
  ticketLevels      TicketLevel[]

  @@map("role")
  @@schema("app")
}

// Permission keys follow domain.resource.action
model Permission {
  key         String           @id
  description String
  sensitive   Boolean          @default(false) // holding it makes TOTP mandatory (06 §3)
  roles       RolePermission[]

  @@map("permission")
  @@schema("app")
}

model RolePermission {
  roleId        Int        @map("role_id")
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permission")
  @@schema("app")
}

enum ScopeKind {
  ALL
  REGION
  AREA
  CENTRE

  @@schema("app")
}

// One row = one role held over one scope. Shape is enforced by a CHECK constraint in 0002_security.
model RoleAssignment {
  id            Int       @id @default(autoincrement())
  userId        String    @map("user_id") @db.Uuid
  roleId        Int       @map("role_id")
  scopeKind     ScopeKind @map("scope_kind")
  regionId      Int?      @map("region_id")
  areaId        Int?      @map("area_id")
  scopeCentreId Int?      @map("scope_centre_id")
  user          AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role      @relation(fields: [roleId], references: [id])
  region        Region?   @relation(fields: [regionId], references: [id])
  area          Area?     @relation(fields: [areaId], references: [id])
  centre        Centre?   @relation(fields: [scopeCentreId], references: [id])

  @@index([userId])
  @@map("role_assignment")
  @@schema("app")
}

// Opaque session token; only its SHA-256 is stored. The scope of every DB transaction derives from it.
// ADR-001 (authentication) decides how sessions are created; this table is what RLS trusts.
model AppSession {
  tokenHash  Bytes     @id @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  stepUpAt   DateTime? @map("step_up_at") @db.Timestamptz
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz // idle timeout
  user       AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("app_session")
  @@schema("app")
}

// ---------- Authentication support (ADR-001) ----------

// Failure counter per login string (existing or not, so lockout cannot enumerate accounts)
model AuthThrottle {
  loginKey    String    @id @map("login_key")
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz

  @@map("auth_throttle")
  @@schema("app")
}

model AuthIpAttempt {
  id BigInt   @id @default(autoincrement())
  ip String
  at DateTime @default(now()) @db.Timestamptz

  @@index([ip, at])
  @@map("auth_ip_attempt")
  @@schema("app")
}

// Short-lived second-factor step between password and session (kind: enrol | totp)
model AuthChallenge {
  tokenHash        Bytes     @id @map("token_hash")
  userId           String    @map("user_id") @db.Uuid
  kind             String
  pendingSecretEnc String?   @map("pending_secret_enc")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  usedAt           DateTime? @map("used_at") @db.Timestamptz
  user             AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_challenge")
  @@schema("app")
}

model AuthRecoveryCode {
  userId   String    @map("user_id") @db.Uuid
  codeHash Bytes     @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz
  user     AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, codeHash])
  @@map("auth_recovery_code")
  @@schema("app")
}

model AuthReset {
  tokenHash Bytes     @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_reset")
  @@schema("app")
}

// ---------- Audit (append-only; T-AUD-*) ----------

enum AuditOutcome {
  OK
  DENIED
  FAILED

  @@schema("app")
}

model AuditLog {
  id             BigInt       @id @default(autoincrement())
  at             DateTime     @default(now()) @db.Timestamptz
  userId         String?      @map("user_id") @db.Uuid
  action         String
  outcome        AuditOutcome
  targetCentreId Int?         @map("target_centre_id")
  targetType     String?      @map("target_type")
  targetId       String?      @map("target_id")
  detail         Json         @default("{}")
  // T-AUD-001 field set, filled by app.audit() from the session, never by the caller
  actorKind      String       @default("user") @map("actor_kind") // user | system:<job> | migration:<run>
  actorRoles     String[]     @map("actor_roles")
  actorScope     Int[]        @map("actor_scope")
  sessionHash    Bytes?       @map("session_hash")
  requestId      String?      @map("request_id")
  clientIp       String?      @map("client_ip")
  reason         String?
  before         Json?
  after          Json?

  @@index([at])
  @@map("audit_log")
  @@schema("app")
}

// ---------- Rate limiting (T-SEC-015 search; migration 0010) ----------
// One row per counted action, per user and bucket. Written and read only by app.rate_take() (no app grants).
model RateHit {
  id     BigInt   @id @default(autoincrement())
  userId String   @map("user_id") @db.Uuid
  bucket String
  at     DateTime @default(now()) @db.Timestamptz

  @@index([userId, bucket, at])
  @@map("rate_hit")
  @@schema("app")
}

// ---------- Numbering mechanism (C-02.2). Policy NP-1..NP-8 is UNAPPROVED. ----------

enum GapRule {
  GAPLESS
  UNIQUE

  @@schema("app")
}

model NumberSeries {
  centreId Int     @map("centre_id")
  docType  String  @map("doc_type")
  period   String
  gapRule  GapRule @map("gap_rule")
  current  BigInt  @default(0)
  centre   Centre  @relation(fields: [centreId], references: [id])

  @@id([centreId, docType, period])
  @@map("number_series")
  @@schema("app")
}

// ---------- Tickets (Stage 2 core; docs/designs/ticket-engine/ticket-engine.md, migration 0009) ----------
// Guard triggers, append-only triggers, RLS, eligibility functions and grants are hand-written in 0009.

enum TicketStatus {
  OPEN
  APPROVED
  REJECTED

  @@schema("app")
}

enum TicketAction {
  RAISE
  APPROVE
  REJECT
  FORWARD

  @@schema("app")
}

// ponytail: three values until the legacy list is readable (SPEC p.38 shows four on one screen)
enum TicketPriority {
  LOW
  MEDIUM
  HIGH

  @@schema("app")
}

model TicketCategory {
  id       Int              @id @default(autoincrement())
  parentId Int?             @map("parent_id") // null = main category
  name     String
  parent   TicketCategory?  @relation("ticketCategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children TicketCategory[] @relation("ticketCategoryParent")
  types    TicketType[]

  @@map("ticket_category")
  @@schema("app")
}

model TicketType {
  id               Int                @id @default(autoincrement())
  code             String             @unique
  name             String
  categoryId       Int                @map("category_id")
  priority         TicketPriority     @default(MEDIUM)
  documentRequired Boolean            @default(false) @map("document_required")
  handlerKey       String             @map("handler_key")
  numberPrefix     String             @map("number_prefix")
  active           Boolean            @default(false)
  category         TicketCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  levels           TicketTypeLevel[]
  viewers          TicketTypeViewer[]
  tickets          Ticket[]

  @@map("ticket_type")
  @@schema("app")
}

model TicketTypeLevel {
  typeId         Int        @map("type_id")
  level          Int
  approverUserId String?    @map("approver_user_id") @db.Uuid
  approverRoleId Int?       @map("approver_role_id")
  type           TicketType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  approverUser   AppUser?   @relation(fields: [approverUserId], references: [id], onDelete: Restrict)
  approverRole   Role?      @relation(fields: [approverRoleId], references: [id], onDelete: Restrict)

  @@id([typeId, level])
  @@map("ticket_type_level")
  @@schema("app")
}

model TicketTypeViewer {
  id     Int        @id @default(autoincrement())
  typeId Int        @map("type_id")
  userId String?    @map("user_id") @db.Uuid
  roleId Int?       @map("role_id")
  type   TicketType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  user   AppUser?   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role?      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([typeId, userId])
  @@unique([typeId, roleId])
  @@map("ticket_type_viewer")
  @@schema("app")
}

// The id is generated by the app before the insert, so the audit row can name it (idempotent raise).
model Ticket {
  id             String           @id @db.Uuid
  number         String           @unique
  typeId         Int              @map("type_id")
  centreId       Int              @map("centre_id")
  raisedBy       String           @map("raised_by") @db.Uuid
  status         TicketStatus     @default(OPEN)
  currentLevel   Int              @default(1) @map("current_level")
  levelCount     Int              @map("level_count")
  assignedUserId String?          @map("assigned_user_id") @db.Uuid
  payload        Json
  reraiseOf      String?          @unique @map("reraise_of") @db.Uuid
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  closedAt       DateTime?        @map("closed_at") @db.Timestamptz
  type           TicketType       @relation(fields: [typeId], references: [id], onDelete: Restrict)
  centre         Centre           @relation(fields: [centreId], references: [id], onDelete: Restrict)
  raiser         AppUser          @relation("ticketRaisedBy", fields: [raisedBy], references: [id], onDelete: Restrict)
  assignedUser   AppUser?         @relation("ticketAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  reraised       Ticket?          @relation("ticketReraise", fields: [reraiseOf], references: [id], onDelete: Restrict)
  reraisedAs     Ticket?          @relation("ticketReraise")
  levels         TicketLevel[]
  events         TicketEvent[]
  documents      TicketDocument[]

  @@index([status, createdAt, id])
  @@index([createdAt(sort: Desc), id])
  @@map("ticket")
  @@schema("app")
}

// Copied from the type at raise, so later setup edits do not move tickets already in progress.
model TicketLevel {
  ticketId       String   @map("ticket_id") @db.Uuid
  centreId       Int      @map("centre_id")
  level          Int
  approverUserId String?  @map("approver_user_id") @db.Uuid
  approverRoleId Int?     @map("approver_role_id")
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  centre         Centre   @relation(fields: [centreId], references: [id], onDelete: Restrict)
  approverUser   AppUser? @relation(fields: [approverUserId], references: [id], onDelete: Restrict)
  approverRole   Role?    @relation(fields: [approverRoleId], references: [id], onDelete: Restrict)

  @@id([ticketId, level])
  @@map("ticket_level")
  @@schema("app")
}

model TicketEvent {
  id       BigInt       @id @default(autoincrement())
  ticketId String       @map("ticket_id") @db.Uuid
  centreId Int          @map("centre_id")
  at       DateTime     @default(now()) @db.Timestamptz
  actorId  String       @map("actor_id") @db.Uuid
  action   TicketAction
  level    Int
  remarks  String?
  toUserId String?      @map("to_user_id") @db.Uuid
  detail   Json         @default("{}")
  ticket   Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  centre   Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)
  actor    AppUser      @relation("ticketEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  toUser   AppUser?     @relation("ticketEventToUser", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_event")
  @@schema("app")
}

// One row per signed upload URL issued; only its requester can attach it, once.
model TicketUpload {
  id           String          @id @db.Uuid
  centreId     Int             @map("centre_id")
  uploadedBy   String          @map("uploaded_by") @db.Uuid
  storageKey   String          @map("storage_key")
  fileName     String          @map("file_name")
  declaredSize BigInt          @map("declared_size")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  centre       Centre          @relation(fields: [centreId], references: [id], onDelete: Restrict)
  uploader     AppUser         @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  document     TicketDocument?

  @@index([uploadedBy, createdAt])
  @@map("ticket_upload")
  @@schema("app")
}

model TicketDocument {
  id          BigInt       @id @default(autoincrement())
  ticketId    String       @map("ticket_id") @db.Uuid
  centreId    Int          @map("centre_id")
  uploadId    String       @unique @map("upload_id") @db.Uuid
  contentType String       @map("content_type") // from the detected file signature, never the browser's claim
  sizeBytes   BigInt       @map("size_bytes")
  at          DateTime     @default(now()) @db.Timestamptz
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  centre      Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)
  upload      TicketUpload @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_document")
  @@schema("app")
}

// Network-wide counters (person-core design; generalises the ticket counter of ticket-engine DD-8).
// series TICKET (period ALL), REGISTER (period ALL, seeded at cutover), ADMISSION (one row per academic year).
model GlobalNumberSeries {
  series  String
  period  String
  current BigInt

  @@id([series, period])
  @@map("global_number_series")
  @@schema("app")
}

// ---------- Person, admission and registration core (person-core design) ----------

enum Gender {
  MALE
  FEMALE
  OTHER

  @@schema("app")
}

enum RegistrationStatus {
  ACTIVE
  DROP
  LEAVE
  TRANSFER

  @@schema("app")
}

// Network-wide: no centre_id. Visible only through an admission in scope (RLS, migration 0011).
// No Aadhaar, religion, caste or disability until D-SEC-4 is signed.
model Person {
  id          String        @id @db.Uuid
  givenName   String        @map("given_name")
  familyName  String?       @map("family_name")
  gender      Gender?
  dateOfBirth DateTime?     @map("date_of_birth") @db.Date
  mobile      String?
  email       String?
  matchKey    String?       @map("match_key") // set by trigger app.person_set_match_key()
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  admissions  Admission[]
  detail      PersonDetail?

  @@index([matchKey])
  @@map("person")
  @@schema("app")
}

// Contact and family details, one row per person at most (docs/designs/learner-details; checks, RLS and grants in 0015).
// Identity stays on person, changed only by changeIdentity(); details are edited by updateDetails().
model PersonDetail {
  personId           String  @id @map("person_id") @db.Uuid
  currentAddress     String? @map("current_address")
  currentPlace       String? @map("current_place")
  currentPincode     String? @map("current_pincode")
  permanentAddress   String? @map("permanent_address")
  permanentPlace     String? @map("permanent_place")
  permanentPincode   String? @map("permanent_pincode")
  bloodGroup         String? @map("blood_group")
  employmentStatus   String? @map("employment_status")
  qualification      String? @map("qualification")
  fatherName         String? @map("father_name")
  fatherOccupation   String? @map("father_occupation")
  fatherPhone        String? @map("father_phone")
  motherName         String? @map("mother_name")
  motherOccupation   String? @map("mother_occupation")
  motherPhone        String? @map("mother_phone")
  guardianName       String? @map("guardian_name")
  guardianRelation   String? @map("guardian_relation")
  guardianPhone      String? @map("guardian_phone")
  guardianOccupation String? @map("guardian_occupation")
  nationality        String?
  version            Int     @default(1)
  person             Person  @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("person_detail")
  @@schema("app")
}

model Admission {
  id            String         @id @db.Uuid
  personId      String         @map("person_id") @db.Uuid
  centreId      Int            @map("centre_id")
  academicYear  String         @map("academic_year")
  admissionNo   String         @unique @map("admission_no")
  admittedOn    DateTime       @map("admitted_on") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  person        Person         @relation(fields: [personId], references: [id], onDelete: Restrict)
  centre        Centre         @relation(fields: [centreId], references: [id], onDelete: Restrict)
  year          AcademicYear   @relation(fields: [academicYear], references: [code], onDelete: Restrict, onUpdate: Restrict)
  registrations Registration[]

  @@unique([id, centreId])
  @@unique([personId, centreId, academicYear], map: "admission_person_centre_year_key") // admission-screens DD-16
  @@index([personId])
  @@map("admission")
  @@schema("app")
}

model Registration {
  id          String             @id @db.Uuid
  admissionId String             @map("admission_id") @db.Uuid
  centreId    Int                @map("centre_id")
  courseCode  String             @map("course_code")
  registerNo  String             @unique @map("register_no")
  status      RegistrationStatus @default(ACTIVE)
  joinDate    DateTime           @map("join_date") @db.Date
  endDate     DateTime?          @map("end_date") @db.Date
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  // composite: keeps registration.centre_id equal to its admission's centre
  admission   Admission          @relation(fields: [admissionId, centreId], references: [id, centreId], onDelete: Restrict)
  centre      Centre             @relation(fields: [centreId], references: [id], onDelete: Restrict)
  course      Course             @relation(fields: [courseCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@index([admissionId])
  @@map("registration")
  @@schema("app")
}

// ---------- Catalogue skeleton (docs/designs/catalogue-skeleton; RLS, checks and grants in migration 0012) ----------
// Identity fields only (DD-1); codes are normalised by normCode() and never change; rows are deactivated, never deleted.

model CourseCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  courses   Course[]

  @@map("course_category")
  @@schema("app")
}

model CourseDivision {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  courses   Course[]

  @@map("course_division")
  @@schema("app")
}

model CentreClass {
  id        Int                 @id @default(autoincrement())
  code      String              @unique
  name      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  centres   Centre[]
  courses   CourseCentreClass[]

  @@map("centre_class")
  @@schema("app")
}

model Course {
  id                Int                 @id @default(autoincrement())
  code              String              @unique
  name              String
  categoryId        Int                 @map("category_id")
  divisionId        Int                 @map("division_id")
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  category          CourseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  division          CourseDivision      @relation(fields: [divisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  registrations     Registration[]
  // course master (docs/designs/course-master/course-master.md); checks and grants in 0016
  displayName       String?             @map("display_name")
  department        String?
  durationType      String?             @map("duration_type")
  durationMonths    Int?                @map("duration_months")
  durationWeeks     Int?                @map("duration_weeks")
  durationDays      Int?                @map("duration_days")
  durationHours     Int?                @map("duration_hours")
  capacity          Int?
  examMinDays       Int?                @map("exam_min_days")
  sortOrder         Int                 @default(0) @map("sort_order")
  visible           Boolean             @default(true)
  materialsRequired Boolean             @default(false) @map("materials_required")
  marklistRequired  Boolean             @default(false) @map("marklist_required")
  noRegFee          Boolean             @default(false) @map("no_reg_fee")
  itMagic           Boolean             @default(false) @map("it_magic")
  keltron           Boolean             @default(false)
  internshipKeltron Boolean             @default(false) @map("internship_keltron")
  selected          Boolean             @default(false)
  keltronShare      Decimal?            @map("keltron_share") @db.Decimal(5, 2)
  classes           CourseCentreClass[]

  @@map("course")
  @@schema("app")
}

// R-091: the centre classes a course may be sold at (course-master DD-2)
model CourseCentreClass {
  courseId      Int         @map("course_id")
  centreClassId Int         @map("centre_class_id")
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  centreClass   CentreClass @relation(fields: [centreClassId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([courseId, centreClassId])
  @@map("course_centre_class")
  @@schema("app")
}

// R-028 Academic Year Master (DD-3); dates are reference data (DD-6).
model AcademicYear {
  code       String      @id
  startsOn   DateTime    @map("starts_on") @db.Date
  endsOn     DateTime    @map("ends_on") @db.Date
  open       Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  admissions Admission[]

  @@map("academic_year")
  @@schema("app")
}
